# Required: @aws-amplify/backend-deployer declares peer typescript@^5, but Expo
# SDK 57 wants typescript@~6. Under strict peer resolution npm silently OMITS
# backend-deployer, and `ampx sandbox` then dies with
# "Cannot find module .../backend-deployer/node_modules/tsx".
#
# Safe for EAS Build: package-lock.json is excluded in .easignore, so EAS runs
# `npm install` (which honours this file) rather than `npm ci`.
legacy-peer-deps=true
